MODEL_BACKEND=mock
MODEL_NAME=gpt-4.1-mini
OPENAI_API_KEY=
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2
API_PORT=8001

SEARCH_BACKEND=static
TAVILY_API_KEY=
MCP_SEARCH_TOOL=web_search
SEARCH_TIMEOUT_SECONDS=35

CHECKPOINT_DB=/app/data/checkpoints.db
APP_DB=/app/data/app.db

# Authentication session (set secure=true when deployed behind HTTPS)
SESSION_COOKIE_NAME=job_agent_session
SESSION_TTL_HOURS=168
SESSION_COOKIE_SECURE=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=job-agent
